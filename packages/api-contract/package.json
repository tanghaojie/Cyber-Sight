{
  "name": "@cyber-ai-forge/api-contract",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && tsc-alias && pnpm verify:dist",
    "dev": "pnpm --filter . run --parallel \"/^dev:.*/\"",
    "dev:aliases": "tsc-alias --watch",
    "dev:types": "tsc --watch --preserveWatchOutput",
    "test": "pnpm build",
    "verify:dist": "node scripts/verify-dist.mjs"
  },
  "dependencies": {
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "tsc-alias": "^1.9.1",
    "typescript": "^5.9.3"
  }
}
