{
  "name": "@cyber-ai-forge/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "pnpm db:foundation:generate",
    "db:migrate": "pnpm db:foundation:migrate && pnpm db:platform:migrate",
    "db:foundation:generate": "drizzle-kit generate --config drizzle.foundation.config.ts",
    "db:foundation:migrate": "drizzle-kit migrate --config drizzle.foundation.config.ts",
    "db:platform:generate": "drizzle-kit generate --config drizzle.platform.config.ts",
    "db:platform:migrate": "drizzle-kit migrate --config drizzle.platform.config.ts",
    "db:check": "tsx src/database.check.ts"
  },
  "dependencies": {
    "@fastify/static": "9.3.0",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-fastify": "^11.1.6",
    "@nestjs/swagger": "^11.2.0",
    "@cyber-ai-forge/api-contract": "workspace:*",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.2",
    "fastify": "5.10.0",
    "postgres": "^3.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.6",
    "@types/node": "^22.0.0",
    "drizzle-kit": "^0.31.10",
    "tsc-alias": "^1.9.1",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  }
}
