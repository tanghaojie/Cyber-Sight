{
  "name": "@jlab/wechat-editor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5174 --strictPort",
    "typecheck": "vue-tsc --noEmit",
    "build": "node scripts/check-boundaries.mjs && vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4174 --strictPort",
    "architecture:check": "node scripts/check-boundaries.mjs"
  },
  "dependencies": {
    "vue": "^3.4.0",
    "pinia": "^2.2.0",
    "element-plus": "^2.14.3",
    "markdown-it": "15.0.2",
    "dompurify": "3.4.16"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.1.0",
    "vite": "^5.4.0",
    "typescript": "^5.5.0",
    "vue-tsc": "^2.1.0",
    "@types/markdown-it": "14.2.0"
  }
}
