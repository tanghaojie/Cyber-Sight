{
  "name": "cyber-ai-forge",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "pnpm --filter @cyber-ai-forge/api-contract build && pnpm --parallel --filter @cyber-ai-forge/api-contract --filter @cyber-ai-forge/backend --filter @cyber-ai-forge/frontend dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:watch": "pnpm --filter @cyber-ai-forge/api-contract build && pnpm --filter @cyber-ai-forge/backend test:watch",
    "test:db": "pnpm --filter @cyber-ai-forge/backend db:check",
    "db:generate": "pnpm --filter @cyber-ai-forge/backend db:generate",
    "db:migrate": "pnpm --filter @cyber-ai-forge/backend db:migrate",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "docs:archive:check": "node scripts/docs/archive-audit.mjs",
    "docs:archive:check:ci": "node scripts/docs/archive-audit.mjs --fail-on-due",
    "lint-staged": "lint-staged",
    "prepare": "simple-git-hooks",
    "preinstall": "npx only-allow pnpm"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,mts,cts,tsx,vue}": [
      "eslint --fix",
      "prettier --write --ignore-unknown"
    ],
    "*.{json,jsonc,md,yml,yaml,css,scss,html}": "prettier --write --ignore-unknown"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "devDependencies": {
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.10.0",
    "lint-staged": "^17.2.0",
    "prettier": "^3.9.6",
    "simple-git-hooks": "^2.13.1",
    "typescript-eslint": "^8.65.0"
  }
}
