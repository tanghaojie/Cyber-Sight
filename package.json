{
  "name": "jtlab",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "pnpm --filter @scaffold/api-contract build && pnpm --parallel --filter @scaffold/api-contract --filter @scaffold/backend --filter @scaffold/frontend dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:watch": "pnpm --filter @scaffold/api-contract build && pnpm --filter @scaffold/backend test:watch",
    "test:db": "pnpm --filter @scaffold/backend db:check",
    "db:generate": "pnpm --filter @scaffold/backend db:generate",
    "db:migrate": "pnpm --filter @scaffold/backend db:migrate",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "lint-staged": "lint-staged",
    "prepare": "simple-git-hooks",
    "preinstall": "npx only-allow pnpm"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,mts,cts,tsx,vue,json,jsonc,md,yml,yaml,css,scss,html}": "prettier --write --ignore-unknown"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "devDependencies": {
    "lint-staged": "^17.2.0",
    "prettier": "^3.9.6",
    "simple-git-hooks": "^2.13.1"
  }
}
